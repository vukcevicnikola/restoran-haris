## 10. SEO (metadataBase, hreflang, sitemap)

Status: `lib/seo.ts` currently contains only the `hreflang` map (typed `Record<Locale, string>`, used for `<html lang>` and the language switcher), and `data/site.ts` exists. Pages have no `<title>`/metadata yet. Because `global.d.ts` types `Locale` and the pathnames, the helpers below need `Locale` instead of `string`, and an `href` typed as a pathname key, for example `keyof typeof routing.pathnames`.

**`lib/seo.ts`** (target)
```ts
import type { Metadata } from 'next';
import { getPathname } from '@/i18n/navigation';
import { routing } from '@/i18n/routing';
import { site } from '@/data/site';

export const SITE_URL = site.url;
export const SITE_NAME = site.name;

export const hreflang: Record<string, string> = {
  me: 'sr-Latn-ME', en: 'en', it: 'it', ru: 'ru', tr: 'tr',
};

export const ogLocale: Record<string, string> = {
  me: 'sr_ME', en: 'en_US', it: 'it_IT', ru: 'ru_RU', tr: 'tr_TR',
};

// '/meni' + 'me' -> https://restoranharis.com/meni
// '/meni' + 'en' -> https://restoranharis.com/en/menu
export function localizedUrl(locale: string, href: string) {
  return SITE_URL + getPathname({ locale, href });
}

export function languageAlternates(href: string) {
  return Object.fromEntries(
    routing.locales.map((l) => [hreflang[l], localizedUrl(l, href)]),
  );
}

export function buildAlternates(locale: string, href: string): Metadata['alternates'] {
  return {
    canonical: localizedUrl(locale, href),
    languages: {
      ...languageAlternates(href),
      'x-default': localizedUrl(routing.defaultLocale, href),
    },
  };
}
```

